# ======================================================================
# GridMind — Environment Variables
# ======================================================================
# Copy this file to .env and fill in your values.
# This is the SINGLE source of truth for all configuration.
# ======================================================================

# --- Application ---
APP_NAME=GridMind
APP_VERSION=1.0.0
APP_MODE=local                          # local | cloud
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
DATABASE_MODE=sqlite                    # sqlite | postgres
DATABASE_URL=sqlite:///./data_storage/gridmind.db
# Future PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/gridmind

# --- Location (Bangalore, Karnataka default) ---
LATITUDE=12.9716
LONGITUDE=77.5946
TIMEZONE=Asia/Kolkata

# --- Weather API (Open-Meteo — FREE, no key required) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive

# --- Karnataka Grid Data ---
# If you have a live Karnataka grid API, set these:
KARNATAKA_GRID_API_URL=
KARNATAKA_GRID_API_KEY=
# If empty, the system uses simulated/historical data automatically

# --- Simulation Defaults ---
SIMULATION_TIMESTEP_SECONDS=60
DEFAULT_NUM_HOUSEHOLDS=50
DEFAULT_SOLAR_CAPACITY_KW=500.0
DEFAULT_WIND_CAPACITY_KW=200.0
DEFAULT_BATTERY_CAPACITY_KWH=1000.0
DEFAULT_BATTERY_MIN_SOC=0.10
DEFAULT_BATTERY_MAX_SOC=0.95
DEFAULT_BATTERY_CHARGE_RATE_KW=100.0
DEFAULT_BATTERY_DISCHARGE_RATE_KW=100.0
DEFAULT_EV_COUNT=20
DEFAULT_EV_BATTERY_KWH=60.0
DEFAULT_INDUSTRIAL_LOAD_KW=1500.0
DEFAULT_CRITICAL_LOAD_KW=500.0
DEFAULT_GRID_IMPORT_LIMIT_KW=5000.0
DEFAULT_GRID_EXPORT_LIMIT_KW=2000.0

# --- ML Models ---
ML_MODEL_DIR=./data_storage/trained_models
ML_MODEL_TYPE=xgboost                   # xgboost | lightgbm | sklearn
FORECAST_HORIZON_MINUTES=60

# --- WebSocket ---
WEBSOCKET_ENABLED=true
POLLING_INTERVAL_SECONDS=2

# --- Agent Toggles (all ON by default) ---
AGENT_COORDINATOR_ENABLED=true
AGENT_RISK_FORECAST_ENABLED=true
AGENT_MARKET_TRADING_ENABLED=true
AGENT_ENERGY_RESOURCE_ENABLED=true
AGENT_DEMAND_MANAGEMENT_ENABLED=true
AGENT_CRITICAL_FACILITY_ENABLED=true

# --- Data Source Toggles ---
KARNATAKA_LIVE_DATA_ENABLED=false
WEATHER_LIVE_DATA_ENABLED=true
USE_HISTORICAL_DATA=true
USE_SIMULATED_DATA=true

# --- Feature Toggles ---
P2P_MARKET_ENABLED=true
SAFETY_VALIDATION_ENABLED=true
DIGITAL_TWIN_ENABLED=true
ANALYTICS_ENABLED=true
BASELINE_COMPARISON_ENABLED=true
SCENARIO_ENGINE_ENABLED=true

# --- Cloud / Future (OFF by default) ---
AWS_ENABLED=false
TWINMAKER_ENABLED=false
S3_STORAGE_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# --- Optional Features (OFF by default) ---
LANGGRAPH_ENABLED=false
CONFORMAL_PREDICTION_ENABLED=false
LLM_EXPLANATIONS_ENABLED=false
LLM_API_KEY=
LLM_MODEL_NAME=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data_storage/gridmind.log
